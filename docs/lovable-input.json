  "siteMap": {
    "description": "Public routes from the existing InnoviaBurst site (React Router v6)",
    "router": "src/App.tsx",
    "publicRoutes": [
      {
        "path": "/",
        "component": "Index",
        "purpose": "Homepage",
        "keyComponents": ["HeroSection", "ProofStrip", "OffersSection", "SolutionsSection", "IndustriesSection", "ResourcesSection", "TrustSection", "WorkSection", "ContactSection"]
      },
      {
        "path": "/automations",
        "component": "AutomationsPage",
        "purpose": "Library of pre-built automation templates",
        "features": ["Search/filter by category, industry, tools", "Sort by impact/speed/popularity", "Quick view drawer", "Request modal integration"]
      },
      {
        "path": "/resources",
        "component": "ResourcesPage",
        "purpose": "Downloadable resources (guides, checklists, templates, calculators)",
        "features": ["Category filter (ROI, AI, CRM, Ops, Compliance)", "Resource type badges", "Featured resources", "Gated content (contact form)"]
      },
      {
        "path": "/trust",
        "component": "TrustPage",
        "purpose": "Trust & Compliance page (DPA, GDPR, security, sub-processors)",
        "features": ["Sticky ToC (desktop)", "Collapsible ToC (mobile)", "Trust pack CTA", "Security questionnaire CTA"]
      },
      {
        "path": "/:slug",
        "component": "OfferPage",
        "purpose": "Dynamic offer detail pages (ai-ops-sprint, automation-build, mvp-launch)",
        "features": ["Hero with timeline/price", "Deliverables list", "Week-by-week breakdown", "FAQ accordion", "CTA to book call"]
      },
      {
        "path": "/work",
        "component": "WorkPage/ComingSoonPage",
        "purpose": "Case studies (coming soon)"
      },
      {
        "path": "/privacy",
        "component": "PrivacyPage",
        "purpose": "Privacy policy"
      },
      {
        "path": "/cookies",
        "component": "CookiesPage",
        "purpose": "Cookie policy"
      },
      {
        "path": "/terms",
        "component": "TermsPage",
        "purpose": "Terms of service"
      },
      {
        "path": "/subprocessors",
        "component": "SubprocessorsPage",
        "purpose": "List of sub-processors for compliance"
      }
    ],
    "adminDashboardRoutes": {
      "recommended": [
        "/admin/dashboard (overview KPIs)",
        "/admin/automations (manage library)",
        "/admin/resources (manage resources)",
        "/admin/offers (manage offers)",
        "/admin/leads (booking/request submissions)",
        "/admin/content (edit page content)",
        "/admin/analytics (site metrics)",
        "/admin/settings (site config, integrations)"
      ]
    }
  },

  "contentModels": {
    "resources": {
      "description": "Downloadable resources (guides, checklists, templates, calculators)",
      "source": "src/pages/ResourcesPage.tsx (currently hardcoded, extract schema)",
      "schema": {
        "key": "string (unique identifier, e.g., 'roiCalculator')",
        "icon": "LucideIcon (from lucide-react, e.g., Calculator, CheckSquare, Brain)",
        "type": "ResourceType enum ('Guide' | 'Checklist' | 'Template' | 'Calculator' | 'Playbook' | 'Reference')",
        "category": "CategoryKey enum ('all' | 'roi' | 'ai' | 'crm' | 'ops' | 'compliance')",
        "tags": "string[] (for search/filter)",
        "featured": "boolean (optional, show in featured section)",
        "updatedAt": "string (ISO date, e.g., '2025-12-30')",
        "timeToComplete": "string (e.g., '15 min', '1 hour')",
        "usefulness": "number (1-10 rating)",
        "href": "string (link to resource or '#contact' for gated)",
        "title_i18n": "Translatable title (from i18n keys)",
        "description_i18n": "Translatable description (from i18n keys)",
        "benefits_i18n": "string[] (key benefits, translatable)"
      },
      "adminFields": [
        "All schema fields above",
        "status (draft | published | archived)",
        "downloadUrl (if not gated)",
        "thumbnailUrl (optional preview image)",
        "createdBy (user ID)",
        "lastModifiedBy (user ID)",
        "viewCount (analytics)",
        "downloadCount (analytics)"
      ],
      "exampleKeys": [
        "roiCalculator",
        "aiChecklist",
        "hubspotHygiene",
        "complianceRoadmap",
        "apiPlaybook",
        "ragGuide",
        "workflowAudit",
        "dpaReference",
        "euAiAct",
        "icoFairness",
        "vendorSecurity",
        "monitoringPlaybook"
      ]
    },

    "automations": {
      "description": "Pre-built automation templates in the library",
      "source": "src/pages/AutomationsPage.tsx",
      "schema": {
        "key": "string (unique ID, e.g., 'leadToMeeting')",
        "category": "string ('Sales' | 'Ops' | 'Support' | 'Finance' | 'Knowledge')",
        "tools": "string[] (e.g., ['HubSpot', 'Slack', 'Calendly'])",
        "deliveryTime": "string (e.g., '1-2 weeks')",
        "deliveryWeeksMin": "number (1)",
        "deliveryWeeksMax": "number (2)",
        "impactScore": "number (1-10, for filtering by impact)",
        "popularityScore": "number (1-10, for sorting by popularity)",
        "createdAt": "string (ISO date)",
        "industry": "string (e.g., 'B2B / SaaS', 'Retail / E-commerce')",
        "title_i18n": "Translatable title",
        "outcome_i18n": "Translatable outcome description",
        "problem_i18n": "Translatable problem statement",
        "steps_i18n": "string[] (workflow steps, translatable)",
        "kpi_i18n": "Translatable KPI description"
      },
      "adminFields": [
        "All schema fields above",
        "status (draft | published | archived)",
        "thumbnailUrl (optional diagram/preview)",
        "detailsUrl (link to full documentation)",
        "requiredTools (vs optional tools)",
        "estimatedHoursSaved (number)",
        "estimatedCost (number)",
        "createdBy (user ID)",
        "lastModifiedBy (user ID)",
        "viewCount (analytics)",
        "requestCount (how many times requested)"
      ],
      "exampleKeys": [
        "leadToMeeting",
        "aiSupportTriage",
        "stripeDunning",
        "shopifyFulfillment",
        "invoiceReminder",
        "recruitmentPipeline",
        "salesHandoff",
        "demoQualification",
        "execOpsDigest",
        "aiKnowledgeBase"
      ]
    },

    "offers": {
      "description": "Productised service offerings (fixed scope packages)",
      "source": "src/pages/OfferPage.tsx",
      "schema": {
        "slug": "string (URL slug, e.g., 'ai-ops-sprint')",
        "title": "string ('AI Ops Sprint', 'Automation Build', 'MVP Launch')",
        "timeline": "string ('10 business days', '4-6 weeks')",
        "bestFor": "string (target audience description)",
        "price": "string ('From £3k', '£15k-£30k')",
        "heroDescription": "string (1-2 sentence pitch)",
        "deliverables": "string[] (bullet list of what's included)",
        "exclusions": "string[] (bullet list of what's NOT included)",
        "successMetrics": "Array<{ metric: string, example: string }>",
        "weekByWeek": "Array<{ week: string, activities: string[] }> (timeline breakdown)",
        "clientInputs": "string[] (what client needs to provide)",
        "faq": "Array<{ q: string, a: string }>"
      },
      "adminFields": [
        "All schema fields above",
        "status (draft | published | archived)",
        "featured (boolean, show on homepage)",
        "orderIndex (for sorting offers)",
        "iconName (Lucide icon name)",
        "ctaLabel (custom CTA text)",
        "ctaUrl (custom CTA link or default to booking)",
        "createdBy (user ID)",
        "lastModifiedBy (user ID)",
        "viewCount (analytics)",
        "conversionRate (analytics)"
      ],
      "existingOffers": [
        "ai-ops-sprint",
        "automation-build",
        "mvp-launch"
      ]
    },

    "leads": {
      "description": "Booking and request submissions from forms",
      "sources": ["BookingModal.tsx", "RequestModal.tsx", "NewsletterForm.tsx"],
      "bookingSchema": {
        "id": "string (UUID)",
        "type": "enum ('booking' | 'request' | 'newsletter')",
        "name": "string",
        "email": "string",
        "company": "string (optional)",
        "role": "string (optional)",
        "goal": "string (what they want to achieve)",
        "interestedIn": "string (optional, topic from query param)",
        "createdAt": "timestamp",
        "source": "string (page URL where form was submitted)",
        "status": "enum ('new' | 'contacted' | 'qualified' | 'converted' | 'closed')",
        "assignedTo": "string (user ID, optional)",
        "notes": "string (admin notes)"
      },
      "requestSchema": {
        "id": "string (UUID)",
        "type": "enum ('booking' | 'request' | 'newsletter')",
        "email": "string",
        "company": "string (optional)",
        "role": "string (optional)",
        "primaryGoal": "string (from dropdown: reduceOps, leadHandling, reporting, aiAssistant, mvp, custom)",
        "tools": "string[] (selected tools from list)",
        "timeline": "string (from dropdown: urgent, soon, planning, exploring, none)",
        "notes": "string (additional details from user)",
        "interestedIn": "string (optional)",
        "createdAt": "timestamp",
        "source": "string",
        "status": "enum ('new' | 'contacted' | 'qualified' | 'converted' | 'closed')",
        "assignedTo": "string (user ID, optional)",
        "adminNotes": "string"
      },
      "adminViews": [
        "All leads (table view with filters)",
        "Lead detail view (full form submission + timeline)",
        "Status pipeline (kanban: new -> contacted -> qualified -> converted)",
        "Assignment (assign to team member)",
        "Notes & follow-ups"
      ]
    },

    "analytics": {
