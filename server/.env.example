# ---------------------------------------------------------------------------
# SERVER-SIDE ONLY. Never prefix anything here with VITE_.
#
# This file's real counterpart (server/.env) is gitignored and never reaches
# the browser. The VITE_ variables in the ROOT .env are the opposite: they are
# inlined into the public JS bundle and committed to git. A Gmail App Password
# in that file would be published twice over.
# ---------------------------------------------------------------------------

# Port the API listens on. nginx proxies /api/ to this. 3000 is the port the
# commented-out proxy block in nginx.prod.conf already expects.
PORT=3000

# Gmail SMTP. Requires 2-Step Verification enabled on the account, then an
# App Password (16 characters) — Google no longer accepts your real password
# over SMTP. Generate at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx

# Where lead notifications are delivered. Can be the same as SMTP_USER.
LEAD_TO=your.address@gmail.com

# Shown as the sender name. The sender ADDRESS is forced to SMTP_USER because
# Gmail rewrites any other From: to the authenticated account anyway.
LEAD_FROM_NAME=InnoviaBurst website

# Only requests with this Origin are accepted. Blocks other sites from posting
# to your endpoint. Comma-separate for multiple.
ALLOWED_ORIGIN=https://innoviaburst.com
