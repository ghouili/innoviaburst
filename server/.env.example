# ---------------------------------------------------------------------------
# SERVER-SIDE ONLY. Never prefix anything here with VITE_.
#
# This file's real counterpart (server/.env) is gitignored and never reaches
# the browser. The VITE_ variables in the ROOT .env are the opposite: they are
# inlined into the public JS bundle and committed to git. A Gmail App Password
# in that file would be published twice over.
# ---------------------------------------------------------------------------

# Port the API listens on. nginx proxies /api/ to this, and 3000 is what the
# upstream block in nginx.prod.conf expects.
PORT=3000

# --- SMTP transport --------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587

# Implicit TLS. Leave EMPTY to derive it from the port, which is almost always
# what you want:
#   587 -> false  (STARTTLS: connects plain, then upgrades)
#   465 -> true   (TLS from the first byte)
# Setting this to true on port 587 makes the connection hang.
MAIL_SECURE=

# Gmail requires 2-Step Verification enabled, then a 16-character App Password
# — Google no longer accepts your real password over SMTP.
# Generate one at: https://myaccount.google.com/apppasswords
MAIL_USER=your.address@gmail.com
MAIL_PASS=xxxxxxxxxxxxxxxx

# --- Message headers -------------------------------------------------------
MAIL_FROM_NAME=InnoviaBurst website

# Leave EMPTY to send as MAIL_USER. Gmail rewrites From: to the authenticated
# account anyway, unless this address is a verified alias on it
# (Gmail → Settings → Accounts → "Send mail as"). Setting an unverified address
# here does not make mail appear to come from it.
MAIL_FROM_ADDRESS=

# Leave EMPTY (recommended). Empty means each notification replies to the
# address the visitor typed, so hitting Reply answers the lead directly. Set a
# fixed address only if every reply should go to one mailbox instead.
MAIL_REPLY_TO=

# Where lead notifications are delivered. Defaults to MAIL_USER if empty.
MAIL_TO=your.address@gmail.com

# --- Access control --------------------------------------------------------
# Only requests carrying this Origin are accepted, which stops other sites
# posting to your endpoint. Comma-separate for multiple.
ALLOWED_ORIGIN=https://innoviaburst.com
