# Client env. Only VITE_-prefixed keys reach the browser bundle, and Vite
# INLINES them at build time — so every value here is public, and changing one
# requires a rebuild + redeploy (deploy.sh runs `npm run build` on the server).
#
# NOTE: this file is committed to git. Never put a secret in it.

# OPTIONAL FALLBACK. Leave empty to use our own /api/leads (the default), which
# sends through Gmail from the VPS — see server/.env.example.
#
# Set a Web3Forms access key here only if you want to bypass the server and
# post straight to that service instead. It is the one key that may live in
# this file: it is public by design and identifies a form, not an account.
# The SMTP credentials must NEVER come here — see the note at the top.
VITE_FORMS_ACCESS_KEY=

# Scheduling link offered on the success screen after an enquiry is sent.
# Paste the BARE link, e.g. https://calendly.com/innoviaburst/15min
# Empty simply hides the button; the form still works and you reply by email.
# NOT embedded — see the comment in src/components/BookingModal.tsx.
VITE_SCHEDULING_URL=

# Where the forms POST. Defaults to /api/leads — our own endpoint on the VPS
# (server/index.mjs), which holds the Gmail credentials and sends the mail.
# Override only to point somewhere else during testing.
VITE_LEAD_ENDPOINT=
