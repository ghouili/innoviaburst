# Client env. Only VITE_-prefixed keys reach the browser bundle, and Vite
# INLINES them at build time — so every value here is public, and changing one
# requires a rebuild + redeploy (deploy.sh runs `npm run build` on the server).
#
# NOTE: this file is committed to git. Never put a secret in it.

# Scheduling link for the "Book a call" modal.
#   Calendly → Event Types → your event → Share → Copy link
#   Paste the BARE link; the app appends the embed parameters itself.
#   e.g. VITE_BOOKING_URL=https://calendly.com/innoviaburst/15min
# Leave empty to disable the embed and fall back to the in-house form.
VITE_BOOKING_URL=
